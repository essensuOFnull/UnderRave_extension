{
	"manifest_version": 3,
	"name": "刀口亼右户仨亼レ仨",
	"author": "essensuOFnull",
	"version": "6.0.0",
	"description": "Набор улучшений для сайтов и браузера Google Chrome, разработанный для членов Подбредья.",
	"permissions": [
		"tabs",
		"scripting",
		"activeTab",
		"declarativeNetRequest",
		"storage",
		"contextMenus",
		"tabCapture",
        "desktopCapture",
		"windows",
		"unlimitedStorage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"web_accessible_resources": [{
		"resources": [
			"initial_config.json",
			"popups/media_mixer/player.html",
			"web_accessible_resources/**/*",
			"styles/nyx.css"
		],
		"matches": ["<all_urls>"]
	}],
	"action": {
		"default_icon": {
			"16": "icon.png",
			"48": "icon.png",
			"128": "icon.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": [
				"libs/jquery-3.3.1.slim.min.js",
				"libs/sha/sha256.js",
				"libs/aes-js/index.js",
				"libs/base64/base64js.min.js",
				"libs/encoding/encoding.js",
				"libs/scrypt/scrypt.js",
				"libs/scrypt/thirdparty/unorm.js",
				"libs/scrypt/thirdparty/buffer.js",
				"libs/scrypt/thirdparty/setImmediate.js",
				"libs/keyexchange/jsbn.js",
				"libs/keyexchange/jsbn2.js",
				"libs/keyexchange/prng4.js",
				"libs/keyexchange/rng.js",
				"libs/keyexchange/ec.js",
				"libs/keyexchange/sec.js",

				"contents/init.js",

				"contents/context_menu.js",
				"contents/video_search.js",
				"contents/lifting_restrictions.js",
				"contents/media_mixer.js",
				"contents/encrypt.js",
				"contents/layout_swapper.js"
			],
			"run_at": "document_start",
			"all_frames": true
		},
		{
			"matches": ["*://nyx-app.ru/*"],
			"js": ["contents/nyx.js"],
			"css": ["styles/nyx.css"],
			"run_at": "document_end",
			"all_frames": true
		},
		{
			"matches": ["*://www.google.com/*"],
			"js": ["contents/google.js"],
			"run_at": "document_end"
		}
	]
}